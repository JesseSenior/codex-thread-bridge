      "properties": {
        "threadId": {
          "title": "Threadid",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "title": "send_message_to_threadArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "send_message_to_threadDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  },
