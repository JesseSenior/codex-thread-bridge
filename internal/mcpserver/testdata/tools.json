  {
    "name": "wait_threads",
    "description": "Wait for up to eight tasks; zero timeout returns an immediate snapshot.\n\nReturn completion, failure, required interaction, or timeout. Reuse each cursor\nas afterCursor, including after an MCP restart. Unchanged turn text is omitted.\nReads never resume tasks. Pending Desktop calls observed by this connection are\nreported; server approval/input flags remain visible across MCP restarts.\n",
    "inputSchema": {
      "$defs": {
        "WaitTarget": {
          "additionalProperties": false,
          "properties": {
            "threadId": {
              "title": "Threadid",
              "type": "string"
            },
            "afterCursor": {
              "default": "",
              "title": "Aftercursor",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "title": "WaitTarget",
          "type": "object"
        }
      },
      "properties": {
        "targets": {
          "items": {
            "$ref": "#/$defs/WaitTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "timeoutMs": {
          "default": 20000,
          "title": "Timeoutms",
          "type": "integer"
        }
      },
      "required": [
        "targets"
      ],
      "title": "wait_threadsArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "wait_threadsDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
