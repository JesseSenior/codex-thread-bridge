        "model": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "title": "send_message_to_threadArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "send_message_to_threadDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  },
