  {
    "name": "read_thread",
    "description": "Read compact task history with messages, tool summaries, and optional truncated outputs. Raw reasoning is excluded. Pass nextCursor for older turns.",
    "inputSchema": {
      "properties": {
        "threadId": {
          "title": "Threadid",
          "type": "string"
        },
        "turnLimit": {
          "default": 10,
          "title": "Turnlimit",
          "type": "integer"
        },
        "cursor": {
          "default": "",
          "title": "Cursor",
          "type": "string"
        },
        "maxOutputCharsPerItem": {
          "default": 4000,
          "title": "Maxoutputcharsperitem",
          "type": "integer"
        },
        "includeOutputs": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "threadId"
      ],
