  {
    "name": "wait_threads",
    "description": "Wait for completion, failure, or required interaction for up to eight tasks. Zero timeout returns a snapshot. Returns compact progress and suppresses final text already delivered through a version-2 cursor. Cursors work across bridge restarts. Commentary alone does not end a wait. Reads never resume tasks.",
    "inputSchema": {
      "$defs": {
        "WaitTarget": {
          "additionalProperties": false,
          "properties": {
            "threadId": {
              "title": "Threadid",
              "type": "string"
            },
            "afterCursor": {
              "default": "",
              "title": "Aftercursor",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "title": "WaitTarget",
          "type": "object"
        }
      },
      "properties": {
        "targets": {
          "items": {
            "$ref": "#/$defs/WaitTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "timeoutMs": {
          "default": 120000,
          "title": "Timeoutms",
          "type": "integer"
        }
      },
      "required": [
        "targets"
      ],
      "title": "wait_threadsArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "wait_threadsDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
