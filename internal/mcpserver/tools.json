[
  {
    "name": "create_thread",
    "description": "Create in an existing directory, optionally with a title and prompt. Explicit model and thinking overrides require a supported server catalog combination. Omitted settings use server defaults. Worktrees are unsupported. Partial failures retain known IDs; never automatically resend an unknown outcome.",
    "inputSchema": {
      "$defs": {
        "Environment": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "local",
                "worktree"
              ],
              "title": "Type",
              "type": "string"
            },
            "startingState": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Startingstate"
            }
          },
          "required": [
            "type"
          ],
          "title": "Environment",
          "type": "object"
        }
      },
      "properties": {
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Environment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "sandbox": {
          "anyOf": [
            {
              "enum": [
                "read-only",
                "workspace-write",
                "danger-full-access"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox"
        },
        "approvalPolicy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvalpolicy"
        },
        "permissions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permissions"
        }
      },
      "required": [
        "cwd"
      ],
      "title": "create_threadArguments",
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "create_threadDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "send_message_to_thread",
    "description": "Send a message, optionally saving model and thinking overrides for the next turn. Active turns are steered without interruption. Unsupported settings updates fail before message delivery. Partial successes retain known IDs; never automatically resend an unknown outcome.",
    "inputSchema": {
      "properties": {
        "threadId": {
          "title": "Threadid",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
